---
/**
 * The "Open in tutor" block (spec S08 "Lesson page block"). The
 * MarkdownContent override renders it on every lesson page after the lesson
 * body, on the page background. It links the "Study with the tutor" guide,
 * which has the install command and the rest of the detail, and shows the
 * paste-ready `/ai-tutor` line for this lesson with a copy button. The
 * absolute lesson URL comes from the page, built with `absoluteUrl()`.
 */
import { href } from '@lib/url';

interface Props {
	/** The absolute URL of the lesson page, `https://schubergphilis.github.io/ai-training/<area>/<lesson>/`. */
	lessonUrl: string;
}

const { lessonUrl } = Astro.props;
const command = `/ai-tutor ${lessonUrl}`;
---

<aside class="tutor-block not-content" data-tutor-block>
	<p class="tutor-title"><a href={href('/guides/tutor/')}>Study with the tutor</a></p>
	<div class="tutor-line">
		<pre><code>{command}</code></pre>
		<button type="button" class="tutor-copy" data-copy={command} aria-label="Copy the /ai-tutor line">Copy</button>
	</div>
</aside>

<script>
	import { mountTutorBlock } from '@scripts/tutor-block';

	mountTutorBlock();
</script>
