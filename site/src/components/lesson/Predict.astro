---
/**
 * Predict the output of real code (spec S01 `predict`). With `answer`, the
 * page grades by comparison and `run` names the fixture CI executes to assert
 * that answer. Without `answer`, it is the honor-system variant: the learner
 * runs it themselves and self-grades.
 *
 * Without `objective`, the block is an ungraded example (spec S03 "Examples",
 * decided 2026-09-20): the page shows the command and its output, CI still
 * runs the fixture, and nothing is a checkpoint. It renders no checkpoint
 * markup, the tag reader (`lib/checkpoint-tags.ts`) skips it, and so it
 * is in no progress record, review page, sidebar count or export. It needs
 * `answer` and `run` (an example that is shown has to be verified) and takes
 * no `hint`, `concepts` or `context`.
 *
 * A graded block with `answer` and no `run` says its output was checked by
 * hand, unless the lesson file lists `proofs` (#311). A foundations page may
 * not carry `run`, and `mise run examples` checks its `text` fences against
 * those fixtures, so the notice would be false there. The block then shows
 * no notice, because a foundations page never points at the program behind
 * it (spec S03 "Foundations audience").
 */
import type { CheckpointPhase } from '@lib/checkpoint-rules';
import { lessonIdOf } from '@lib/lesson-context';
import { lessonProofsOf } from '@lib/lessons';
import CheckpointShell from './CheckpointShell.astro';
import SectionTitle from './SectionTitle.astro';

interface Props {
	id: string;
	/** The objective the checkpoint evidences. Absent: an ungraded example. */
	objective?: string;
	title: string;
	/** Required for a checkpoint; not allowed on an ungraded example. */
	hint?: string;
	/** S02 concept ids the checkpoint exercises, at least one (spec S03 "Checkpoints"). Not allowed on an ungraded example. */
	concepts?: string[];
	/** One paragraph that makes the item readable outside its lesson; the review page shows it. */
	context?: string;
	answer?: string;
	run?: string;
	review?: boolean;
	revision?: number;
	/** `first` (default), `review` or `practice` (spec S03 "Checkpoint props"). */
	phase?: CheckpointPhase;
	/** Marks this block as the lesson's canonical example (spec S03 "Examples"). Read from the MDX source by lib/reference.ts; not rendered. */
	canonical?: boolean;
}
const { id, objective, title, hint, concepts, context, answer, run, review, revision, phase } = Astro.props;
const graded = objective !== undefined;
const honor = answer === undefined;
if (!graded) {
	if (answer === undefined || run === undefined)
		throw new Error(`Predict "${id}": an ungraded example (no objective) needs answer and run`);
	if (hint !== undefined || concepts !== undefined || context !== undefined || phase !== undefined)
		throw new Error(`Predict "${id}": an ungraded example (no objective) takes no hint, concepts, context or phase`);
}
// Read only when the "checked by hand" notice could render.
const handChecked = graded && !run && !honor && (await lessonProofsOf(lessonIdOf(Astro))).length === 0;
---

{
	graded ? (
		<CheckpointShell
			{id}
			{objective}
			{title}
			hint={hint ?? ''}
			concepts={concepts as string[]}
			{context}
			{review}
			{revision}
			{phase}
			{honor}
			kind="predict"
			checkLabel={honor ? 'Record' : 'Check'}
		>
			<slot />
			<Fragment slot="body">
				<div data-answer={answer} data-run={run} class="cp-predict">
					<label>
						<span class="cp-label">{honor ? 'Your prediction' : 'What is printed?'}</span>
						<textarea rows={honor ? 3 : 1} spellcheck="false"></textarea>
					</label>
					{honor ? (
						<fieldset class="cp-selfgrade">
							<legend>After running it, how did your prediction hold up?</legend>
							<label>
								<input type="radio" name={`${id}-selfgrade`} value="pass" /> It matched
							</label>
							<label>
								<input type="radio" name={`${id}-selfgrade`} value="partial" /> Partly
							</label>
						</fieldset>
					) : (
						<pre class="cp-reveal" hidden>{answer}</pre>
					)}
					{run && (
						<p class="cp-verified">
							Output verified in CI from <code>site/examples/{run}</code>.
						</p>
					)}
					{handChecked && <p class="cp-verified">This example is not run in CI; the output was checked by hand.</p>}
				</div>
			</Fragment>
		</CheckpointShell>
	) : (
		<section class="example not-content" id={id} data-example data-run={run}>
			<header class="cp-head">
				<span class="cp-kind">Example · run it</span>
			</header>
			<SectionTitle {id} {title} />
			<div class="cp-stem">
				<slot />
			</div>
			<div class="cp-body">
				<span class="cp-label">Output</span>
				<pre class="example-output">{answer}</pre>
				<p class="cp-verified">
					Output verified in CI from <code>site/examples/{run}</code>.
				</p>
			</div>
		</section>
	)
}
