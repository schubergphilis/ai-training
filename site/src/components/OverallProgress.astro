---
/**
 * One bar for the whole site plus a "continue" link to the first unfinished
 * lesson, and one line per course with review items due (spec S05 "Where
 * reviews surface"). Used at the top of the progress page and on the landing
 * page.
 */
import { buildCatalog } from '@lib/catalog';
import { href } from '@lib/url';

interface Props {
	/** Landing layout: bar and buttons only (continue + topic map), no summary line. */
	landing?: boolean;
}
const { landing = false } = Astro.props;
const catalog = await buildCatalog();
const first = catalog.flatMap((c) => c.lessons)[0];
---

<div class="not-content overall" data-overall data-landing={String(landing)} data-catalog={JSON.stringify(catalog)} data-base={href('/')}>
	<div class="overall-row">
		<div class="overall-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-bar><div></div></div>
		<strong data-percent>0%</strong>
		<span class="overall-skipped" data-skipped hidden></span>
	</div>
	{!landing && <p class="overall-text" data-text>No progress yet.</p>}
	<ul class="overall-due" data-due-lines hidden></ul>
	<p class="overall-actions">
		<a class="overall-continue" data-continue href={first ? href(`/${first.id}/`) : href('/concepts/')}>Start with: {first?.title ?? 'Concepts'}</a>
		{landing && <a class="overall-map" href={href('/map/')}>Topic map</a>}
	</p>
</div>

<style>
	/* A card on the page, as the learning platform shows progress (spec S14). */
	.overall { margin: 1rem 0 1.5rem; padding: 1rem 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: var(--at-radius-lg); background: var(--at-surface); }
	.overall-row { display: flex; align-items: center; gap: 0.75rem; }
	.overall-bar { flex: 1; height: 0.75rem; border-radius: var(--at-radius-pill); background: var(--sl-color-gray-5); overflow: hidden; }
	.overall-bar > div { height: 100%; width: 0; background: var(--at-done); transition: width 0.3s; }
	.overall-skipped { color: var(--sl-color-gray-3); font-size: 0.9rem; }
	.overall-text { margin: 0.4rem 0 0; color: var(--sl-color-gray-3); font-size: 0.9rem; }
	.overall-due { margin: 0.5rem 0 0; padding: 0; list-style: none; font-size: 0.9rem; }
	.overall-due li { margin: 0.2rem 0; }
	.overall-actions { margin: 0.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
	.overall-continue, .overall-map { display: inline-block; padding: 0.45rem 1rem; border-radius: var(--at-radius-pill); font-weight: 600; text-decoration: none; }
	.overall-continue { background: var(--sl-color-bg-accent); color: var(--sl-color-text-invert); }
	.overall-map { border: 1px solid var(--sl-color-gray-4); color: var(--sl-color-text); background: var(--sl-color-bg-nav); }
</style>

<script>
	import { mountOverallProgress } from '@scripts/overall-progress';

	mountOverallProgress();
</script>
