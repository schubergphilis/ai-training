---
/**
 * The topic map (spec S02 "Rendering rules"): every topic from the YAML,
 * one column per area, colored by the state of the lessons that cover it.
 * Prerequisite edges are drawn client-side from the box positions.
 */
import { getCollection } from 'astro:content';
import { getAreas } from '@lib/areas';
import { jsonForScript } from '@lib/json';
import { getLessons } from '@lib/lessons';
import { href } from '@lib/url';

const topics = (await getCollection('topics')).map((t) => t.data);
const lessons = await getLessons();
const byArea = (await getAreas()).map((a) => {
	const list = topics.filter((t) => t.area === a.slug);
	// Order by prerequisite depth within the area, then by name.
	const depth = new Map<string, number>();
	const visit = (id: string, seen: Set<string>): number => {
		const known = depth.get(id);
		if (known !== undefined) return known;
		if (seen.has(id)) return 0;
		seen.add(id);
		const t = list.find((x) => x.id === id);
		const local = (t?.links.prerequisites ?? []).filter((p) => list.some((x) => x.id === p));
		const d = local.length ? Math.max(...local.map((p) => visit(p, seen))) + 1 : 0;
		depth.set(id, d);
		return d;
	};
	for (const t of list) visit(t.id, new Set());
	list.sort((x, y) => (depth.get(x.id) ?? 0) - (depth.get(y.id) ?? 0) || x.name.localeCompare(y.name));
	return { area: a, topics: list };
});
const coverage = topics.map((t) => ({
	id: t.id,
	lessons: lessons.filter((l) => l.data.covers === t.id).map((l) => l.id),
}));
const edges = topics.flatMap((t) =>
	t.links.prerequisites.map((from) => ({ from, to: t.id, cross: from.split('/')[0] !== t.area })),
);
---

<div class="not-content">
	<div class="topic-map" data-topic-map data-coverage={JSON.stringify(coverage)}>
		<svg class="topic-map-edges" aria-hidden="true"></svg>
		{
			byArea.map(({ area, topics }) => (
				<div class="topic-col">
					<p class="topic-col-title">{area.name}</p>
					{topics.map((t) => (
						<a class="topic-node" href={href(`/topics/${t.id}/`)} data-topic={t.id} data-state="untouched" title={t.definition}>
							{t.name}
						</a>
					))}
				</div>
			))
		}
		<script is:inline type="application/json" data-edges set:html={jsonForScript(edges)} />
	</div>
	<p class="topic-legend">
		<span data-k="untouched">not started</span>
		<span data-k="in-progress">in progress</span>
		<span data-k="finished">finished</span>
	</p>
</div>

<script>
	import { mountTopicMap } from '@scripts/topic-map';

	mountTopicMap();
</script>
