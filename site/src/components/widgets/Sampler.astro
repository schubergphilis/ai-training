---
/**
 * Widget: next-token sampling with temperature over a tiny fixed distribution.
 * Teaches, never grades (spec S03 "Widgets").
 */
---

<div class="not-content sampler" data-sampler>
	<p class="sampler-prefix">The cat sat on the …</p>
	<label class="sampler-temp">
		Temperature <input type="range" min="0.05" max="2" step="0.05" value="1" />
		<output>1.00</output>
	</label>
	<div class="sampler-bars"></div>
	<button type="button" class="sampler-go">Sample next token</button>
	<p class="sampler-out" aria-live="polite"></p>
</div>

<style>
	.sampler { border: 1px solid var(--sl-color-gray-5); border-radius: var(--at-radius-lg); padding: 1rem 1.25rem; margin: 1.5rem 0; }
	.sampler-prefix { font-weight: 700; margin: 0 0 0.5rem; }
	.sampler-temp { display: flex; gap: 0.5rem; align-items: center; }
	.sampler-temp input { flex: 1; max-width: 20rem; }
	.sampler-bars { margin: 0.75rem 0; display: grid; gap: 0.25rem; }
	/* The rows are built with createElement and never get Astro's scope class, so their rules need :global(). */
	.sampler-bars :global(.bar) { display: grid; grid-template-columns: 8rem 1fr 4rem; align-items: center; gap: 0.5rem; font-family: var(--sl-font-mono); font-size: 0.85rem; }
	.sampler-bars :global(.pct) { text-align: right; font-variant-numeric: tabular-nums; }
	.sampler-bars :global(.fill) { height: 1rem; background: var(--sl-color-accent); border-radius: 2px; transition: width 0.2s; }
	.sampler-go { padding: 0.35rem 0.85rem; border-radius: var(--at-radius-pill); border: 1px solid var(--sl-color-gray-4); background: var(--sl-color-bg-nav); cursor: pointer; font: inherit; }
	.sampler-out { margin: 0.75rem 0 0; font-size: 1.1rem; min-height: 1.5rem; }
</style>

<script>
	import { mountSamplers } from '@scripts/sampler';

	mountSamplers();
</script>
