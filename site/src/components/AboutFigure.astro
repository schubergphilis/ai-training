---
/**
 * One content figure of the About page, counted at build time
 * (`lib/about-figures.ts`, issue #762): `<AboutFigure of="lessons" />`.
 * An unknown key fails the build and lists the keys there are.
 */
import { aboutFigure, getAboutFigures } from '@lib/about-figures';

interface Props {
	of: string;
}
const { of } = Astro.props;
const value = aboutFigure(await getAboutFigures(), of);
---

<span data-about-figure={of}>{value}</span>
