---
/** One page per competency (spec S02 "Stable URLs"): objectives, behaviors, alignment, lessons serving it. */
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CompetencyCourse from '@components/CompetencyCourse.astro';
import CompetencyObjectives from '@components/CompetencyObjectives.astro';
import References from '@components/References.astro';
import { areaOf, getAreas } from '@lib/areas';
import { type BibliographyEntry, competencyHeadings, createCitations, renderObjectives } from '@lib/citations';
import { href } from '@lib/url';

export async function getStaticPaths() {
	const competencies = await getCollection('competencies');
	return competencies.map((c) => ({ params: { id: c.data.id }, props: { competency: c.data } }));
}

const { competency } = Astro.props;
const area = areaOf(await getAreas(), competency.area);
const topics = (await getCollection('topics')).map((t) => t.data);
// Alignment rows (spec S10 "Alignment") are kept per framework; a competency's rows are the ones naming one of its objectives.
const own = new Set(competency.objectives.map((o) => o.id));
const alignment = (await getCollection('alignment')).flatMap((f) =>
	f.data.rows.filter((r) => r.objectives.some((o) => own.has(o))).map((r) => ({ framework: f.data.framework, ...r })),
);
// Behaviors cite with `(@key)` (spec S03 "Citations and terms"); the page numbers them and lists the References last.
const bibliography: Record<string, BibliographyEntry> = Object.fromEntries(
	(await getCollection('bibliography')).map((e) => [e.id, e.data]),
);
const citations = createCitations(bibliography, `competency ${competency.id}`);
const objectives = renderObjectives(competency.objectives, citations);
const references = citations.references();
const headings = competencyHeadings(alignment.length, references.length);
---

<StarlightPage frontmatter={{ title: competency.statement, description: `Competency ${competency.id}` }} headings={headings}>
	<p><em>{area.name}</em> · competency <code>{competency.id}</code></p>
	<CompetencyCourse area={area} />
	<p>
		<strong>Draws on:</strong>{' '}
		{competency.topics.map((t, i) => (<>{i > 0 && ', '}<a href={href(`/topics/${t}/`)}>{topics.find((x) => x.id === t)?.name ?? t}</a></>))}
	</p>

	<h2 id="objectives">Learning objectives</h2>
	<CompetencyObjectives objectives={objectives} />

	{
		alignment.length > 0 && (
			<>
				<h2 id="alignment">Alignment</h2>
				<table>
					<thead><tr><th>Framework</th><th>Code</th><th>Asks</th><th>Objectives here</th></tr></thead>
					<tbody>
						{alignment.map((a) => (
							<tr>
								<td>{a.framework}</td>
								<td>{a.code}</td>
								<td>{a.asks}</td>
								<td>{a.objectives.filter((o) => own.has(o)).map((o) => o.split('/').pop()).join(', ')}</td>
							</tr>
						))}
					</tbody>
				</table>
			</>
		)
	}

	<References references={references} />
</StarlightPage>
