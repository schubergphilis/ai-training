---
/**
 * The review page, one per course (spec S05 "The review page"). Items are the
 * course's checkpoints that are due; their markup is fetched from the lesson
 * pages at runtime and bound in review mode (Give Up, stage pills, frequency).
 * A due item may be asked through one of its `review` alternates (spec S05
 * "Which checkpoint a review asks"): the catalog lists each item's
 * alternates, `servedCheckpoint` picks one from the item's history, and the
 * alternate's hidden section is shown in the item's place.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ReviewIntro from '@components/ReviewIntro.astro';
import { getAreas } from '@lib/areas';
import { reviewAlternatesOf } from '@lib/checkpoint-rules';
import { checkpointsOf, getLessons, habitsOf } from '@lib/lessons';
import { renderInline } from '@lib/reference';
import { href } from '@lib/url';

export async function getStaticPaths() {
	return (await getAreas()).map((a) => ({ params: { area: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const lessons = await getLessons(area.slug);
const catalog = lessons.map((l) => {
	const all = checkpointsOf(l, { alternates: true });
	return {
		id: l.id,
		title: l.data.title,
		href: href(`/${l.id}/`),
		checkpoints: all
			.filter((c) => c.phase === 'first' && c.reviewable)
			.map((c) => ({ id: c.id, revision: c.revision, alternates: reviewAlternatesOf(c, all) })),
		// The lesson's habits (spec S07 "Where habits surface"): the text as inline HTML, so the due card reads as on the lesson page.
		habits: habitsOf(l).map((h) => ({ id: h.id, html: renderInline(h.text) })),
	};
});
---

<StarlightPage frontmatter={{ title: `Review: ${area.name}`, description: `Review items due for the ${area.name} course.`, tableOfContents: false }}>
	<div class="not-content review" data-review={area.slug} data-catalog={JSON.stringify(catalog)}>
		<ReviewIntro area={area.slug} />
		<div class="review-habits" data-habits hidden></div>
		<div class="review-progress" aria-label="Items in this session"><div data-bar></div></div>
		<p data-status role="status"></p>
		<div data-items></div>
		<div class="review-actions">
			<a href={href(`/${area.slug}/`)}>Back to the course</a>
		</div>
	</div>
</StarlightPage>

<script>
	import { mountReviewPage } from '@scripts/review-page';

	mountReviewPage(document);
</script>
