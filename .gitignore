# mise local overrides (the committed .mise.toml is the shared config)
.mise.local.toml
mise.local.toml
.mise/

# Claude
# `.claude/` itself is tracked on purpose — settings.json is shared config.
# Only per-user state and scratch worktrees are ignored.
.claude/settings.local.json
.claude/worktrees

# Environment files that hold secrets, at any depth: a pattern without a
# slash matches in every directory. The keys-and-secrets lesson says the
# course repository ignores every `.env`, and its fixture commits
# `env.sample` instead.
.env
.env.*

# Vale styles fetched by `mise run prose-sync` (or `vale --config
# .vale-eval.ini sync` for packages under evaluation) from the release URLs
# pinned in .vale.ini and .vale-eval.ini.
.vale/styles/write-good/
.vale/styles/proselint/
.vale/styles/Readability/

# Python bytecode from the scripts/ helpers, and the uv/pytest/ruff state
# that `mise run py-*` leaves behind
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
.vale/styles/Google/
.vale/styles/ai-tells/
# Shipped inside the ai-tells zip.
.vale/styles/config/templates/
# Harper (vale-cli/Harper), pinned in .vale-eval.ini only. Its zip also
# ships a .vale-config and a dictionary.
.vale/styles/Harper/
.vale/styles/.vale-config/
.vale/styles/config/dictionaries/
docs/prose/reports/

# Per-agent scratch space in a worktree (docs/agents/orchestration.md,
# "Scratch space and worktrees"). Agents may delete it freely.
.scratch/
