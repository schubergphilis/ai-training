{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "dictionaries": [
    "softwareTerms",
    "companies",
    "project-words"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./cspell-words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "node_modules",
    "site/dist",
    "site/.astro",
    "site/examples",
    "docs/prose/reports",
    "bun.lock",
    "cspell-words.txt",
    ".vale/styles"
  ],
  "overrides": [
    {
      "filename": "site/src/data/areas/*/lessons/*.yaml",
      "ignoreRegExpList": [
        "/^\\s*section: [a-z0-9-]+$/gm"
      ]
    },
    {
      "filename": "site/src/data/bibliography.yaml",
      "ignoreRegExpList": [
        "/^AI Hero video [A-Za-z0-9_-]{11}:$/gm"
      ]
    }
  ],
  "languageSettings": [
    {
      "languageId": "markdown,mdx",
      "ignoreRegExpList": [
        "/`[^`\\n]+`/g",
        "/^\\s*section: [a-z0-9-]+$/gm"
      ]
    }
  ]
}
